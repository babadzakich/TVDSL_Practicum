// Recursion and calls to functions declared later in the module.
fact(n: int) requires n >= 0 returns r: int {
  if (n == 0) r = 1; else r = n * fact(n - 1);
}

isEven(n: int) returns r: int {
  if (n == 0) r = 1; else r = isOdd(n - 1);
}

isOdd(n: int) returns r: int {
  if (n == 0) r = 0; else r = isEven(n - 1);
}
