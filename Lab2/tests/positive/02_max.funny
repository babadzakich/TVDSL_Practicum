// Maximum of two numbers and of three numbers.
max2(a: int, b: int) returns m: int ensures m >= a and m >= b {
  if (a > b) {
    m = a;
  } else {
    m = b;
  }
}

max3(a: int, b: int, c: int) returns m: int {
  if (a >= b) {
    if (a >= c) m = a; else m = c;
  } else {
    {
      if (b >= c) m = b;
      else m = c;
    }
  }
}
