function accumulate(x: int, n: int) returns (r: int) {
  values:
    %x: int [parameter]
    %n: int [parameter]
    %r: int [return]
    %i: int [local]
    %t4: int [temporary]
    %t5: int [temporary]
    %t6: int [temporary]
    %t7: int [temporary]
    %t8: int [temporary]
    %t9: int [temporary]
    %t10: int [temporary]
b0:  ; preds=[] succs=[b1]
  %t4 = const 0 @2:7
  %r = copy %t4 @2:3
  %t5 = const 0 @3:7
  %i = copy %t5 @3:3
  jump b1
b1:  ; preds=[b0,b6] succs=[b2,b3]
  branch %i < %n, b2, b3
b2:  ; preds=[b1] succs=[b4,b5]
  branch %i < %x, b4, b5
b3:  ; preds=[b1] succs=[]
  return %r
b4:  ; preds=[b2] succs=[b6]
  %t6 = add %r %i @6:11
  %r = copy %t6 @6:7
  jump b6
b5:  ; preds=[b2] succs=[b6]
  %t7 = const 1 @8:15
  %t8 = sub %r %t7 @8:11
  %r = copy %t8 @8:7
  jump b6
b6:  ; preds=[b4,b5] succs=[b1]
  %t9 = const 1 @10:13
  %t10 = add %i %t9 @10:9
  %i = copy %t10 @10:5
  jump b1
}
