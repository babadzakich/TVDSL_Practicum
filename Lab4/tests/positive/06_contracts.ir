formula nonnegative(x: int) => x >= 0
function clamp(x: int) returns (r: int) {
  values:
    %x: int [parameter]
    %r: int [return]
    %i: int [local]
    %t3: int [temporary]
    %t4: int [temporary]
    %t5: int [temporary]
  requires nonnegative(x)
  ensures r >= 0
b0:  ; preds=[] succs=[b1]
  %i = copy %x @4:3
  jump b1
b1:  ; preds=[b0,b2] succs=[b2,b3]
  invariant i <= 0
  %t3 = const 0 @5:14
  branch %i < %t3, b2, b3
b2:  ; preds=[b1] succs=[b1]
  %t4 = const 1 @6:13
  %t5 = add %i %t4 @6:9
  %i = copy %t5 @6:5
  jump b1
b3:  ; preds=[b1] succs=[]
  %r = copy %i @8:3
  assert r >= 0 @9:3
  assume x >= -10 @10:3
  return %r
}
