function pair(x: int) returns (a: int, b: int) {
  values:
    %x: int [parameter]
    %a: int [return]
    %b: int [return]
    %t3: int [temporary]
    %t4: int [temporary]
b0:  ; preds=[] succs=[]
  %a = copy %x @2:3
  %t3 = const 1 @3:11
  %t4 = add %x %t3 @3:7
  %b = copy %t4 @3:3
  return %a %b
}
function sum_pair(x: int) returns (r: int) {
  values:
    %x: int [parameter]
    %r: int [return]
    %left: int [local]
    %right: int [local]
    %t4: int [temporary]
b0:  ; preds=[] succs=[]
  %left, %right = call pair %x @7:3
  %t4 = add %left %right @8:7
  %r = copy %t4 @8:3
  return %r
}
