function simplified(x: int) returns (r: int) {
  values:
    %x: int [parameter]
    %r: int [return]
    %first: int [local]
    %second: int [local]
    %t4: int [temporary]
    %t5: int [temporary]
    %t6: int [temporary]
    %t7: int [temporary]
    %t8: int [temporary]
    %t9: int [temporary]
b0:  ; preds=[] succs=[]
  %t4 = const 0 @2:15
  %t5 = add %x %t4 @2:11
  %first = copy %t5 @2:3
  %t6 = const 1 @3:20
  %t7 = mul %first %t6 @3:12
  %second = copy %t7 @3:3
  %t8 = const 0 @4:16
  %t9 = sub %second %t8 @4:7
  %r = copy %t9 @4:3
  return %r
}
