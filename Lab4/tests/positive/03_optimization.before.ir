function opt(x: int) returns (r: int) {
  values:
    %x: int [parameter]
    %r: int [return]
    %t: int [local]
    %t3: int [temporary]
    %t4: int [temporary]
    %t5: int [temporary]
    %t6: int [temporary]
    %t7: int [temporary]
    %t8: int [temporary]
b0:  ; preds=[] succs=[]
  %t3 = const 0 @2:11
  %t4 = add %x %t3 @2:7
  %t = copy %t4 @2:3
  %t5 = const 1 @3:11
  %t6 = mul %t %t5 @3:7
  %t7 = const 2 @3:15
  %t8 = add %t6 %t7 @3:7
  %r = copy %t8 @3:3
  return %r
}
