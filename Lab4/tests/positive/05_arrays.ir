function increment_at(a: int[], i: int) returns (r: int[], observed: int) {
  values:
    %a: int[] [parameter]
    %i: int [parameter]
    %r: int[] [return]
    %observed: int [return]
    %value: int [local]
    %t5: int [temporary]
    %t6: int [temporary]
    %t7: int [temporary]
    %t8: int [temporary]
b0:  ; preds=[] succs=[]
  %r = copy %a @2:3
  %t5 = load_element %r %i @3:11
  %value = copy %t5 @3:3
  %t6 = const 1 @4:18
  %t7 = add %value %t6 @4:10
  %r = array_set %r %i %t7 @4:3
  %t8 = load_element %r %i @5:14
  %observed = copy %t8 @5:3
  return %r %observed
}
